PORT=5000
NODE_ENV=development
JWT_SECRET=super_secret_agentic_jwt_key_2026_change_in_production

# Allowed Frontend URL for strict CORS in production (e.g., https://your-app.vercel.app)
CLIENT_URL=http://localhost:3000

# Supabase Credentials (optional: runs in memory fallback if unset)
SUPABASE_URL=https://your-supabase-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-or-anon-key

# Google Gemini AI Key
GEMINI_API_KEY=your_gemini_api_key_here
